################################################################################
# Terraform Variables Example - Production
################################################################################
# Copie este arquivo para terraform.tfvars e preencha os valores
# NÃO COMMITE o arquivo terraform.tfvars com valores sensíveis
################################################################################

# General
aws_account_id = "123456789012"

# Application
app_base_url = "https://api.coliseu.app"

# JWT (sensível - use secrets no CI/CD)
jwt_secret = "your-jwt-secret-here"

# MongoDB (sensível - use secrets no CI/CD)
mongodb_url      = "mongodb+srv://user:password@cluster.mongodb.net"
mongodb_database = "coliseu_prd"

# Resend (sensível - use secrets no CI/CD)
resend_api_key = "re_xxxxxxxxxxxx"

